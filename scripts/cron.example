# Ledrix — ONE cron job. No separate queue:work cron.
#
# cPanel fields (do NOT type "* * * * *" into a single box, and do NOT type "every minute"):
#
#   Minute    */5
#   Hour      *
#   Day       *
#   Month     *
#   Weekday   *
#   Command   (one line below)
#
# Namecheap / many shared hosts block true every-minute cron and show:
#   "You did not format the date and time settings correctly."
#   */5 is the minimum they allow. Laravel drains the queue for ~4.5 minutes each tick.
#
# VPS crontab (every minute is OK there):
#   * * * * * cd /path/to/ledrix && php artisan schedule:run >> .../scheduler.log 2>&1

cd /home/devxeeba/public_html/ledrix && /usr/local/bin/php artisan schedule:run >> /home/devxeeba/public_html/ledrix/storage/logs/scheduler.log 2>&1
