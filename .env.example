APP_NAME=The-Ledrix-Team
APP_ENV=local
APP_KEY=base64:Igur8eLBNyP5HurBBo2POi1v+5DriQGbAbn3Dr/CFW8=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Local artisan serve: http://127.0.0.1:8000  |  Production MUST be https://ledrix.co (never localhost)
APP_URL=http://127.0.0.1:8000
# Optional override for schema/canonical org URL if APP_URL differs
SEO_SITE_URL=

# Google Search Console verification (optional — paste content value from GSC)
GOOGLE_SITE_VERIFICATION=
# Meta / Facebook domain verification (Business Manager → Brand Safety → Domains)
# Required on production .env then: php artisan config:cache
FACEBOOK_DOMAIN_VERIFICATION=jlxk4j6fin2lyekgklald69hs4zb7s

# Paid ads tracking — required on production .env for Events Manager
META_PIXEL_ID=894618783344155
GOOGLE_ADS_ID=
GOOGLE_ADS_TRIAL_CONVERSION_LABEL=
GOOGLE_ADS_LEAD_CONVERSION_LABEL=
GTM_ID=
# Fallback plan slug for /lp/agency-crm-trial when no package is marked popular
MARKETING_DEFAULT_TRIAL_PLAN=starter

# Enterprise: DB-per-tenant isolation (F-28) — off by default; enable on VPS with CREATE DATABASE privilege
TENANT_DB_ISOLATION=false
TENANT_DB_PREFIX=ledrix_tenant_
TENANT_DB_PROVISION_ON_REGISTER=true

# Enterprise: SCIM user provisioning (requires bearer token; pairs with OIDC SSO)
SCIM_ENABLED=false
SCIM_BEARER_TOKEN=
SCIM_DEFAULT_ADMIN_ROLE=admin

SUPER_ADMIN_EMAIL=owner@ledrix.app
SUPER_ADMIN_PASSWORD=admin123



UPLOAD_MAX_FILESIZE=20M
POST_MAX_SIZE=25M

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

FORCE_SUPER_ADMIN_OWNER_2FA=false
FORCE_TENANT_ADMIN_2FA=false

# Platform SSO (OIDC) — runtime config also editable in Super Admin → SSO
SSO_ENABLED=false
SSO_PROVIDER_NAME=OIDC
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_SCOPES="openid profile email"
SSO_AUDIENCE=
# Optional static endpoints (skip discovery) for private IdPs / tests
# SSO_AUTHORIZATION_ENDPOINT=
# SSO_TOKEN_ENDPOINT=
# SSO_USERINFO_ENDPOINT=
SSO_HTTP_TIMEOUT=15

APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# Super Admin Database
DB_SUPER_CONNECTION=central
DB_SUPER_HOST=127.0.0.1
DB_SUPER_PORT=3306
DB_SUPER_DATABASE=ledrix_central
DB_SUPER_USERNAME=root
DB_SUPER_PASSWORD=
# Default CRM Database (local tenant db)
DB_CONNECTION=primary
DB_PRIMARY_HOST=127.0.0.1
DB_PRIMARY_PORT=3306
DB_PRIMARY_DATABASE=ledrix_primary
DB_PRIMARY_USERNAME=root
DB_PRIMARY_PASSWORD=


SESSION_DRIVER=database
SESSION_CONNECTION=primary
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# queue jobs — use database (or redis) in production; sync is fine for local dev only
QUEUE_CONNECTION=database

# Mail — use smtp in production (log driver writes to storage/logs only)
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Must match an existing mailbox; keep MAIL_FROM_ADDRESS the same unless you use a separate no-reply account.
MAIL_FROM_ADDRESS="no-reply@ledrix.co"
MAIL_FROM_NAME="${APP_NAME}"
# Set false on shared hosting when mail.yourdomain.com TLS cert is *.web-hosting.com (see PRODUCTION.md §7).
MAIL_VERIFY_PEER=true


CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


BROADCAST_DRIVER=pusher
PUSHER_APP_ID=12345678910
PUSHER_APP_KEY=abcdefghijklmnopqrstuvwxyz
PUSHER_APP_SECRET=thisismysecretkeyhere
PUSHER_APP_CLUSTER=mt1


# Tenant SaaS subscription merchants (Stripe / JazzCash / PayFast / Meezan):
# Manage in Super Admin → Payment Accounts (central DB). Do not store merchant secrets here.
#
# Optional policy / ops knobs only:
JAZZCASH_TRIAL_REMINDER_DAYS=3
JAZZCASH_GRACE_DAYS=7
JAZZCASH_CURRENCY=PKR
BANK_TRANSFER_GRACE_DAYS=7
RAAST_QR_MODE=dynamic
RAAST_QR_EXPIRY_DAYS=7
BILLING_ADMIN_EMAIL=

# SaaS invoice tax (0 = off). Applied after referral discounts on new invoices.
INVOICE_TAX_RATE=0
INVOICE_TAX_LABEL=Tax

# Security tets any time 
# php vendor/bin/phpunit tests/Feature/SellerPortalSecurityTest.php tests/Feature/ClientPortalSecurityTest.php --testdox


# ── Production cron (ONE line — runs queues + all scheduled tasks) ──
# Linux:  crontab -e  →  paste line from scripts/cron.example
# Windows: Task Scheduler every minute → scripts/schedule-run.ps1
# After deploy: bash scripts/post-deploy.sh  (or scripts/post-deploy.ps1)
#
# * * * * * cd /path/to/ledrix && php artisan schedule:run >> storage/logs/scheduler.log 2>&1
#
# Queues are drained every minute by the scheduler (no separate queue:work cron needed).
# Local dev without cron: set QUEUE_CONNECTION=sync  OR  run: php artisan schedule:work


# Stripe Webhook Endpoint to Use:
# To receive Stripe webhooks, you need to define a URL in your app that listens to these events. In your Stripe Dashboard:
# Go to Developers > Webhooks.
# Click on Add endpoint and enter your webhook URL, e.g., https://yourdomain.com/stripe/webhook.


# https://digiprojectmanagers.com/api/webhooks/stripe
# checkout.session.async_payment_succeeded
# checkout.session.async_payment_failed
# checkout.session.completed
# checkout.session.expired


# https://digiprojectmanagers.com/api/webhooks/stripe/dispute
# charge.dispute.created
# charge.dispute.updated
# charge.dispute.closed


# https://digiprojectmanagers.com/api/webhooks/stripe/refund
# charge.refunded
# charge.refunded.updated



# Paypal Webhook Endpoint to Use:

# https://digiprojectmanagers.com/api/webhooks/paypal
# PAYMENT.SALE.COMPLETED
# PAYMENT.SALE.PENDING
# PAYMENT.SALE.CANCELED


# https://digiprojectmanagers.com/api/webhooks/paypal/dispute
# Disputes:
# CUSTOMER.DISPUTE.CREATED
# CUSTOMER.DISPUTE.UPDATED
# CUSTOMER.DISPUTE.RESOLVED


# https://digiprojectmanagers.com/api/webhooks/paypal/refund
# Refunds:
# PAYMENT.CAPTURE.REFUNDED
# PAYMENT.SALE.REFUNDED


# Webhook endpoints — see routes/api.php /api/webhooks/*
